    <script src="https://cdn.jsdelivr.net/npm/tsparticles@2/tsparticles.bundle.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const scrollProgress = document.getElementById("scroll-progress");
        function updateScrollProgress() {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (scrollProgress) scrollProgress.style.width = progress + "%";
        }
        window.addEventListener("scroll", updateScrollProgress);
        updateScrollProgress();

        const languageSection = document.getElementById("languages");
        if (languageSection) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                document.querySelectorAll(".lang-bar__fill").forEach(bar => {
                  bar.style.width = (bar.dataset.targetWidth || 0) + "%";
                });
                observer.disconnect();
              }
            });
          }, { threshold: 0.3 });
          observer.observe(languageSection);
        }

        const taglineEl = document.querySelector(".interactive-tagline");
        document.querySelectorAll(".tagline-toggle .pill").forEach(pill => {
          pill.addEventListener("click", () => {
            document.querySelectorAll(".tagline-toggle .pill").forEach(p => p.classList.remove("pill--active"));
            pill.classList.add("pill--active");
            const msg = pill.getAttribute("data-message");
            if (msg && taglineEl) {
              taglineEl.classList.add("text-fade-out");
              setTimeout(() => {
                taglineEl.textContent = msg;
                taglineEl.classList.remove("text-fade-out");
                taglineEl.classList.add("text-fade-in");
                setTimeout(() => taglineEl.classList.remove("text-fade-in"), 300);
              }, 150);
            }
          });
        });

        function smoothScrollTo(targetId) {
          const target = document.getElementById(targetId);
          if (!target) return;
          window.scrollTo({ top: target.offsetTop - 70, behavior: "smooth" });
        }
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          anchor.addEventListener("click", evt => {
            const targetId = anchor.getAttribute("href").substring(1);
            if (document.getElementById(targetId)) {
              evt.preventDefault();
              smoothScrollTo(targetId);
            }
          });
        });

        const sections = document.querySelectorAll("section[data-section-id]");
        const dots = document.querySelectorAll(".side-nav__dot");
        dots.forEach(dot => dot.addEventListener("click", () => smoothScrollTo(dot.getAttribute("data-target"))));
        const sectionObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("data-section-id");
              dots.forEach(dot => dot.classList.toggle("side-nav__dot--active", dot.getAttribute("data-target") === id));
            }
          });
        }, { threshold: 0.4 });
        sections.forEach(sec => sectionObserver.observe(sec));

        function getParticlesConfig(theme) {
          const base = { fullScreen: { enable: true, zIndex: -1 }, background: { color: "#050816" }, fpsLimit: 60, detectRetina: true };
          const presets = {
            playful: { number: 80, speed: 1.8, color: ["#0d6efd", "#6610f2", "#20c997", "#f8d210"] },
            minimal: { number: 35, speed: 0.8, color: "#6b7280" },
            calm: { number: 60, speed: 1.2, color: ["#0d6efd", "#6610f2", "#20c997"] }
          };
          const p = presets[theme] || presets.calm;
          return Object.assign({}, base, {
            particles: {
              number: { value: p.number, density: { enable: true, area: 900 } },
              color: { value: p.color },
              links: { enable: true, distance: 130, color: "#6c757d", opacity: 0.42, width: 1 },
              move: { enable: true, speed: p.speed, direction: "none", random: true, outModes: { default: "bounce" } },
              opacity: { value: 0.5 },
              size: { value: { min: 1, max: 4 } },
              shape: { type: "circle" }
            },
            interactivity: { events: { onHover: { enable: true, mode: "grab" }, onClick: { enable: true, mode: "push" }, resize: true }, modes: { push: { quantity: 3 } } }
          });
        }

        let currentTheme = "calm";
        if (window.tsParticles) tsParticles.load("tsparticles", getParticlesConfig(currentTheme));
        document.querySelectorAll(".particles-toggle .pill").forEach(btn => {
          btn.addEventListener("click", () => {
            currentTheme = btn.getAttribute("data-theme") || "calm";
            document.querySelectorAll(".particles-toggle .pill").forEach(b => b.classList.remove("pill--active"));
            btn.classList.add("pill--active");
            if (window.tsParticles) tsParticles.load("tsparticles", getParticlesConfig(currentTheme));
          });
        });
      });
    </script>
